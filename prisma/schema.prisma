generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hero {
  id          String   @id @default("main_hero")
  videoUrl    String
  eyebrow     String
  headline    String
  subheadline String
  ctaText     String
  ctaLink     String
  updatedAt   DateTime @updatedAt
}

model About {
  id        String   @id @default("main_about")
  title     String
  lead      String
  body      String
  imageUrl  String
  updatedAt DateTime @updatedAt
  ctaText   String
  eyebrow   String
}

model Podcast {
  id          String   @id @default(uuid())
  videoId     String
  title       String
  description String
  views       Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  createdAt   DateTime @default(now())
  order       Int      @default(0)
}

model Guest {
  id        String   @id @default(uuid())
  name      String
  role      String
  image     String
  link      String
  createdAt DateTime @default(now())
  order     Int      @default(0)
}

model GalleryImage {
  id        String   @id @default(uuid())
  imageUrl  String
  createdAt DateTime @default(now())
  order     Int      @default(0)
}

model Testimonial {
  id        String   @id @default(uuid())
  quote     String
  author    String
  role      String
  createdAt DateTime @default(now())
}

model ContactSettings {
  id          String @id @default("main_contact")
  email       String
  eyebrow     String
  title       String
  description String
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Float
  description String
  images      String[]
  category    String   @default("Collection")
  createdAt   DateTime @default(now())
}

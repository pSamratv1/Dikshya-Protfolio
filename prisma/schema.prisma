generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hero {
  id          String   @id @default("main_hero")
  videoUrl    String
  eyebrow     String
  headline    String
  subheadline String
  ctaText     String
  ctaLink     String
  updatedAt   DateTime @updatedAt
}

model About {
  id        String   @id @default("main_about")
  title     String
  lead      String
  body      String
  imageUrl  String
  updatedAt DateTime @updatedAt
  ctaText   String
  eyebrow   String
}

model Podcast {
  id          String   @id @default(uuid())
  videoId     String
  title       String
  description String
  views       Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  createdAt   DateTime @default(now())
  order       Int      @default(0)
}

model Guest {
  id        String   @id @default(uuid())
  name      String
  role      String
  image     String
  link      String
  createdAt DateTime @default(now())
  order     Int      @default(0)
}

model GalleryImage {
  id        String   @id @default(uuid())
  imageUrl  String
  createdAt DateTime @default(now())
  order     Int      @default(0)
}

model Testimonial {
  id        String   @id @default(uuid())
  quote     String
  author    String
  role      String
  createdAt DateTime @default(now())
}

model ContactSettings {
  id          String @id @default("main_contact")
  email       String
  eyebrow     String
  title       String
  description String
}

model Product {
  id          String      @id @default(uuid())
  name        String
  price       Float
  quantity    Int     @default(0)
  description String
  details     String?     @default("Handcrafted.")
  care        String?
  images      String[]
  videos      String[]    // <--- NEW: Array of video URLs (MP4/WebM)
  category    String      @default("Collection")
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
  reviews     Review[]    // <--- NEW: Relation to reviews
}
// ... existing models

model Review {
  id        String   @id @default(uuid())
  rating    Int      // 1 to 5
  
  // --- NEW FIELDS ---
  title     String?  // Title of the review (e.g. "Great product!")
  comment   String   // Main review text
  recommend Boolean  @default(true) // "Yes, I recommend this"
  
  // User Snapshot (Stored directly on review for easy display)
  userId     String
  userName   String
  userAvatar String? 

  // Relations
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     Int         @default(autoincrement()) // Friendly ID (e.g. #1001)
  total           Float
  status          String      @default("PENDING") // PENDING, PAID, FAILED
  isPaid          Boolean     @default(false)
  
  stripeSessionId String?     @unique // To link Stripe back to this order
  
  // User info (snapshot at time of purchase)
  userId          String?
  customerEmail   String?     // Important for Guest Checkout
  customerPhone   String?     // Important to Connect to Client
  address         String?     // Stored as JSON string
  
  items           OrderItem[]
  createdAt       DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}